light:
  - platform: esp32_rmt_led_strip
    id: led_strip
    chipset: WS2812
    pin: GPIO19
    num_leds: 50
    channel_colors: RGB
    name: "Cupboard Light"
    restore_mode: RESTORE_DEFAULT_OFF
    effects:
      - addressable_rainbow:

